# Scripts de instalación desactivados (D-030, D-034).
# La lista de tests/unit/plataforma/npmrc.test.ts es un inventario de los paquetes del bloqueo que
# traen script de instalación (hoy solo fsevents), no una lista de excepciones: ninguno se ejecuta.
# Si una dependencia necesitara ejecutarlo, hará falta una excepción exacta en el
# scripts-de-instalacion.json reservado del diseño 002 (§Suministro), con revisión y dictamen del auditor-seguridad.
ignore-scripts=true
