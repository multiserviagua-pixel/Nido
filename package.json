{
  "name": "nido",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --config vitest.config.ts",
    "tipos": "next typegen && tsc --noEmit -p tsconfig.json",
    "estilo": "prettier --check . --config .prettierrc.json --ignore-path .prettierignore && eslint --config eslint.config.mjs --max-warnings 0 .",
    "arnes": "node scripts/comprobar-specs.mjs",
    "navegador": "playwright test --config playwright.config.ts",
    "aislamiento": "node scripts/probar-modelo.mjs",
    "operar": "node scripts/conector/operar.mjs",
    "conector:ciclo": "node scripts/conector/ciclo-local.mjs",
    "conector:comprobar": "node scripts/conector/comprobar-conector.mjs",
    "pruebas-bd": "node --env-file-if-exists=.env.local scripts/conector/pruebas-bd.mjs",
    "verificar": "npm run tipos && npm run estilo && npm run test && npm run aislamiento && npm run arnes && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "ajv": "8.20.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-pgtap": "0.0.18",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-security": "4.2.1",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "web-vitals": "6.2.3"
  }
}
